(version v0.17.0)

(build
 (all_platforms ((action (run dune build -p %{pkg-self:name} -j %{jobs})))))

(depends
 (all_platforms
  (ocaml
   core
   core_kernel
   expect_test_helpers_core
   jane-street-headers
   jst-config
   ppx_jane
   ppx_optcomp
   sexplib
   timezone
   uopt
   base-threads
   dune
   spawn)))

(depexts
 ((linux-headers)
  (= %{os_family} alpine)))

(source
 (fetch
  (url
   https://github.com/janestreet/core_unix/archive/refs/tags/v0.17.0.tar.gz)
  (checksum
   sha256=175025e240ed90647d817b1af5e4174bf146505903ed671e645f8a5d5f497182)))
